# ---- deployment
DOMAIN=vaultchain.example.com
AWS_REGION=ap-southeast-2
CHAIN_ID=133
RPC_URL=https://testnet.hsk.xyz
# frontend origins allowed to call api/agent: the Cloudflare domain and the workers.dev URL
CORS_ORIGINS=https://vaultchain.example.com,https://vaultchain-web.example.workers.dev

# ---- database (RDS in production; local postgres with --profile localdb)
DATABASE_URL=postgres://vaultchain:vaultchain@postgres:5432/vaultchain
POSTGRES_PASSWORD=vaultchain

# ---- keys: loaded from AWS Secrets Manager by aws/load-secrets.sh, never committed
# ORACLE_SIGNER_KEY=
# RELAYER_KEY=
# ANTHROPIC_API_KEY=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# PRICECHARTING_TOKEN=
# PSA_API_TOKEN=
# SHIPPING_ENC_KEY=      32-byte hex: encrypts shipping addresses at rest
# INTERNAL_TOKEN=        shared secret between agent and api (seller floor lookup)

# ---- price indexer
INDEXER_INTERVAL_MINUTES=60
ENABLE_SCRAPERS=false
SCRAPER_DELAY_MS=8000
DEMO_FALLBACK=true

# ---- oracle publisher
PUBLISH_DEVIATION_BPS=100
HEARTBEAT_HOURS=12
MIN_CONFIDENCE=30

# ---- HSP (HashKey Settlement Platform)
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
HSP_MERCHANT_NAME=VaultChain

# ---- agent
AGENT_MODEL=claude-opus-5-5

# ---- vault back office (comma-separated operator wallets allowed to register slabs / read addresses)
VAULT_ADMINS=
# shown to sellers who ship a slab in for inspection
VAULT_SHIPPING_ADDRESS="VaultChain Vault\nAttn: Intake\n<street>\n<city> <postal code>\nSingapore"
